# Self-contained build toolchain, restored by tools/README.md. Somebody else's
# binaries; they do not belong in our history.
tools/roslyn/
tools/refasm/

# Build output and packaged releases.
build/
release/*/
release/*.zip

# Runtime state, if anybody ever runs the mod from inside the repo.
*.log
*.log.1
tanks.json
*.bak

# Editor and OS noise.
.vs/
obj/
bin/
Thumbs.db
desktop.ini

# Contact sheets and scratch renders. meter.gif and meter_full.png are kept as
# documentation; anything else under preview/ is something I made to squint at once.
preview/meter_sheet.png

# Python's own build noise. One .pyc was tracked for a while; it is nobody's business.
__pycache__/
*.pyc
